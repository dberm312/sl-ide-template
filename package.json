{
  "name": "sl-ide",
  "private": true,
  "type": "module",
  "description": "sl-ide: an IDE for building slides with Claude Code, Codex or any AI agent",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "audit": "./scripts/audit.sh",
    "check": "node scripts/check.mjs",
    "pdf": "./scripts/pdf.sh",
    "publish-deck": "node scripts/publish-deck.mjs",
    "shots": "./scripts/shots.sh",
    "lab": "./scripts/lab.sh",
    "fonts": "./scripts/fonts.sh",
    "doctor": "node scripts/doctor.js",
    "new-project": "./scripts/new-project.sh",
    "use-format": "node scripts/use-format.mjs",
    "skills": "npx -y skills@latest experimental_install && node scripts/doctor.js",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "playwright test",
    "bench": "node scripts/bench.mjs",
    "feedback": "node scripts/feedback.mjs",
    "agent-bench": "node scripts/agent-bench.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
